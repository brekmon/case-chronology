venv/

# Generated by samples/make_samples.py. Not committed on purpose: the samples
# should be produced by the script so anyone can verify they are synthetic.
samples/*.pdf
samples/*.docx
samples/*.png

# TOOL OUTPUT. Every one of these can contain text extracted from whatever was
# ingested. On a real matter they would carry privileged content straight into a
# commit, so none of them are ever tracked. This list is not optional.
ingest.json
*.ingest.json
coverage.txt
chronology.md
claims.md
*.chronology.md
*.claims.md

# Your real claims file. claims.example.txt is the only one that ships.
claims.txt

